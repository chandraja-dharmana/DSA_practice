# Knuth-Morris-Pratt KMP String Matching Algorithm
# https://chatgpt.com/share/6ad496bd-b780-83ee-92d1-e3c8a82b93d7

arr=['a','b','a','b','d']

#don't use set - we need a specific pattern
len_arr=len(arr)
lps=[0]*len_arr

lps[0]=0
len_lps=0

for i in range(1,len_arr):
    while len_lps>0 and arr[i]!=arr[len_lps]:
        len_lps=lps[len_lps-1]
    if arr[i]==arr[len_lps]:
        len_lps+=1
    lps[i]=len_lps

print(lps)
#result - [0, 0, 1, 2, 0]

############################################################################3

#find if arr occurs in arr1
subarr=['a','b','a','b','d']  # index j

arr1=['a','b','a','b','c','a','b','c','a','b','a','b','a','b','d'] # index i

j=0
i=0

while i<len(arr1):
    if subarr[j]==arr1[i]:
        j+=1
        i+=1
    else:
        if j==0:
            i+=1
        else:
            j=lps[j-1]

# This checks whether j is zero, not whether the whole pattern was found.
# For example, if only the first two characters match before the
# text ends, j will be 2. Your code would incorrectly print "found".
if not j:
    print("not found")
else:
    print("found")